rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApproved() {
      return isAuthed() && userDoc().status == 'approved';
    }

    function isAdmin() {
      return isApproved() && userDoc().role == 'admin';
    }

    function isProtectedDraftFieldUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['status', 'finalizedAt', 'finalizedBy', 'allocation']);
    }

    function changesOnlyPlayerMetadata(i) {
      return request.resource.data.players[i].diff(resource.data.players[i])
        .affectedKeys()
        .hasOnly([
          'primaryColors',
          'splashColors',
          'deckPhotoUrl',
          'deckPhotoPath',
          'deckPhotoUploadedAt'
        ]);
    }

    function playerSlotUpdateAllowed(i) {
      return i >= resource.data.players.size()
        || request.resource.data.players[i] == resource.data.players[i]
        || (
          resource.data.players[i].userId == request.auth.uid
          && changesOnlyPlayerMetadata(i)
        );
    }

    function ownedPlayerMetadataUpdate() {
      return resource.data.keys().hasAll(['players'])
        && request.resource.data.keys().hasAll(['players'])
        && request.resource.data.players.size() == resource.data.players.size()
        && resource.data.players.size() <= 32
        && playerSlotUpdateAllowed(0)
        && playerSlotUpdateAllowed(1)
        && playerSlotUpdateAllowed(2)
        && playerSlotUpdateAllowed(3)
        && playerSlotUpdateAllowed(4)
        && playerSlotUpdateAllowed(5)
        && playerSlotUpdateAllowed(6)
        && playerSlotUpdateAllowed(7)
        && playerSlotUpdateAllowed(8)
        && playerSlotUpdateAllowed(9)
        && playerSlotUpdateAllowed(10)
        && playerSlotUpdateAllowed(11)
        && playerSlotUpdateAllowed(12)
        && playerSlotUpdateAllowed(13)
        && playerSlotUpdateAllowed(14)
        && playerSlotUpdateAllowed(15)
        && playerSlotUpdateAllowed(16)
        && playerSlotUpdateAllowed(17)
        && playerSlotUpdateAllowed(18)
        && playerSlotUpdateAllowed(19)
        && playerSlotUpdateAllowed(20)
        && playerSlotUpdateAllowed(21)
        && playerSlotUpdateAllowed(22)
        && playerSlotUpdateAllowed(23)
        && playerSlotUpdateAllowed(24)
        && playerSlotUpdateAllowed(25)
        && playerSlotUpdateAllowed(26)
        && playerSlotUpdateAllowed(27)
        && playerSlotUpdateAllowed(28)
        && playerSlotUpdateAllowed(29)
        && playerSlotUpdateAllowed(30)
        && playerSlotUpdateAllowed(31);
    }

    function nonAdminDraftUpdateAllowed() {
      return !isProtectedDraftFieldUpdate()
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['players'])
          || ownedPlayerMetadataUpdate()
        );
    }

    // Users — anyone can create their own; only admin can read all or change status/role
    match /users/{userId} {
      allow read: if isAuthed() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthed() && request.auth.uid == userId;
      allow update: if isAdmin()
        || (isAuthed() && request.auth.uid == userId
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['role', 'status']));
      allow delete: if isAdmin();
    }

    // Public profiles — name only, no email; any authenticated user can read
    // Only approved users are in this collection (written/deleted by admin on status change)
    match /publicProfiles/{userId} {
      allow read: if isAuthed();
      allow create, update: if isAdmin()
        || (isAuthed() && request.auth.uid == userId
            && request.resource.data.keys().hasOnly(['name']));
      allow delete: if isAdmin();
    }

    // Pack catalog — approved users read; admin write
    match /packCatalog/{packId} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    // Cubes — approved users read; admin write
    match /cubes/{cubeId} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    // Chaos inventory — approved users read; admin write
    match /packs/{packId} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    // Private inventory — approved users read all (for Draft Inventory view);
    // users write only their own; admin can write any (needed for batchDeduct on finalize)
    match /privateInventory/{itemId} {
      allow read: if isApproved();
      allow create, update: if isApproved()
        && (isAdmin() || request.resource.data.ownerId == request.auth.uid);
      allow delete: if isApproved()
        && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    // Drafts — approved users read all and create;
    // only admin can set status to 'finalized'
    match /drafts/{draftId} {
      allow read: if isApproved();
      allow create: if isApproved();
      allow update: if isApproved() && (
        isAdmin()
        || nonAdminDraftUpdateAllowed()
      );
      allow delete: if isAdmin();
    }
  }
}
